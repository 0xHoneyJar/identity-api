{
  "persistence_mode": "standard",
  "integrity_enforcement": "strict",
  "drift_resolution": "code",
  "disabled_agents": [],
  "memory": {
    "notes_file": "grimoires/loa/NOTES.md",
    "trajectory_dir": "grimoires/loa/a2a/trajectory",
    "trajectory_retention_days": 30
  },
  "edd": {
    "enabled": true,
    "min_test_scenarios": 3,
    "trajectory_audit": true
  },
  "compaction": {
    "enabled": true,
    "threshold": 5
  },
  "integrations": [
    "github"
  ],
  "run_mode": {
    "enabled": true,
    "defaults": {
      "max_cycles": 20,
      "timeout_hours": 8
    },
    "sprint_plan": {
      "branch_prefix": "",
      "default_branch_name": "w2.5-identity-resolve-facade",
      "consolidate_pr": true,
      "commit_prefix": "feat",
      "include_commits_by_sprint": true
    }
  },
  "upgrade": {
    "auto_commit": true,
    "auto_tag": true,
    "commit_prefix": "chore"
  }
}
